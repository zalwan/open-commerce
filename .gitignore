# AI-Native Repository Standard v1.0 — Generic ignore rules
# Technology-specific entries belong to the adopting project.
# Keep this file minimal; extend only for the project's actual stack.

# OS artifacts
.DS_Store
Thumbs.db

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# Local environment
.env
.env.local
*.local

# Logs and temp
*.log
tmp/
temp/

# Build outputs (generic; refine per stack)
dist/
build/
out/
.svelte-kit/
.svelte-kit-tsconfig.json

# Stack: Go + SvelteKit (Open Commerce)
app/frontend/node_modules/
app/frontend/.svelte-kit/
app/backend/api
app/backend/data/
pgdata/

# Runtime uploads (DATA_DIR default ./data/uploads, CWD-dependent)
data/

# Secrets (never commit)
*.pem
*.key
secrets/
